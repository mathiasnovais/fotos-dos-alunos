{
  "name": "Fotos dos Alunos — upload para Drive + registro no Supabase",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fotos/googlefotos",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "wh-fotos-001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "fotos-googlefotos"
    },
    {
      "parameters": {
        "url": "https://SEU-PROJETO.supabase.co/auth/v1/user",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "COLE_AQUI_A_CHAVE_ANON"
            },
            {
              "name": "Authorization",
              "value": "={{ $json.headers.authorization }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-valida-token",
      "name": "Validar token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-token-ok",
      "name": "Token valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "url": "=https://SEU-PROJETO.supabase.co/rest/v1/supervisores?select=id,nome,ativo&ativo=eq.true&email=eq.{{ $json.email }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "COLE_AQUI_A_SERVICE_ROLE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer COLE_AQUI_A_SERVICE_ROLE_KEY"
            }
          ]
        },
        "options": {}
      },
      "id": "http-busca-supervisor",
      "name": "Buscar supervisor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-supervisor-ok",
      "name": "Supervisor ativo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, -100]
    },
    {
      "parameters": {
        "inputDataFieldName": "foto",
        "name": "={{ $('Webhook').item.json.body.matricula }}-{{ $('Webhook').item.json.body.nome }}.jpg",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "COLE_AQUI_O_ID_DA_PASTA_DO_DRIVE"
        },
        "options": {}
      },
      "id": "gdrive-upload",
      "name": "Google Drive — Upload",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1100, -160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://SEU-PROJETO.supabase.co/rest/v1/fotos",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "COLE_AQUI_A_SERVICE_ROLE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer COLE_AQUI_A_SERVICE_ROLE_KEY"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  aluno_id: Number($('Webhook').item.json.body.aluno_id),\n  drive_file_id: $json.id,\n  drive_url: $json.webViewLink || null,\n  enviado_por: $('Buscar supervisor').item.json.id\n}) }}",
        "options": {}
      },
      "id": "http-insere-foto",
      "name": "Registrar foto no Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, -160]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "resp-ok",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1540, -160]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, erro: \"não autorizado\" }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "resp-401",
      "name": "Responder 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 140]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, erro: \"supervisor não autorizado\" }) }}",
        "options": {
          "responseCode": 403
        }
      },
      "id": "resp-403",
      "name": "Responder 403",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, 40]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Validar token", "type": "main", "index": 0 }]]
    },
    "Validar token": {
      "main": [[{ "node": "Token valido?", "type": "main", "index": 0 }]]
    },
    "Token valido?": {
      "main": [
        [{ "node": "Buscar supervisor", "type": "main", "index": 0 }],
        [{ "node": "Responder 401", "type": "main", "index": 0 }]
      ]
    },
    "Buscar supervisor": {
      "main": [[{ "node": "Supervisor ativo?", "type": "main", "index": 0 }]]
    },
    "Supervisor ativo?": {
      "main": [
        [{ "node": "Google Drive — Upload", "type": "main", "index": 0 }],
        [{ "node": "Responder 403", "type": "main", "index": 0 }]
      ]
    },
    "Google Drive — Upload": {
      "main": [[{ "node": "Registrar foto no Supabase", "type": "main", "index": 0 }]]
    },
    "Registrar foto no Supabase": {
      "main": [[{ "node": "Responder OK", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
